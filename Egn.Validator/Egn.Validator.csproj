<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Authors>Rumen Novachkov</Authors>
    <PackageId>Bulgarian.Egn.Validator</PackageId>
    <Product>EgnValidator</Product>
    <Description>
		Library for validation of the Bulgarian personal Identification numbers,
		with static method Egn.isValid(string egn), Egn.TryGetInfo(string egn, out EgnInfo? info) and one ValidationAttribute [EGN]</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>bulgaria, bulgarian, identification, number, personal, attribute, egn, ssn</PackageTags>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <RepositoryUrl>https://github.com/RNovachkov/Egn.Validator.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Version>1.4.0</Version>
    <PackageIcon>Bulgarian.Egn.Validator.png</PackageIcon>
  </PropertyGroup>

  <ItemGroup>
	<None Include="Assets/Bulgarian.Egn.Validator.png" Pack="true" PackagePath="\" />
    <None Include="..\README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Assets\" />
  </ItemGroup>

</Project>
